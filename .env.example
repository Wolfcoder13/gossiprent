# Copy to .env.local for local development. Everything here is optional.

# Postgres connection string. Leave unset locally to use the built-in database
# (stored in ./.data/pglite). On Vercel, adding Neon from the Storage tab sets
# this for you.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional direct (non-pooled) connection used for migrations. Neon's Vercel
# integration sets this automatically.
# DATABASE_URL_UNPOOLED=

# Built-in local database only: where to store it, and whether to fill a brand
# new one with demo landlords, renters, properties, and reviews (default: yes in
# `npm run dev`, no in a production build).
# PGLITE_DATA_DIR=.data/pglite
# SEED_DEMO_DATA=true

# Turn off login/sign-up rate limiting. Only for automated tests.
# AUTH_RATE_LIMIT=off

# Max Postgres connections per server instance (default 5).
# DATABASE_POOL_MAX=5
